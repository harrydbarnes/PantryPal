rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(id) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(id)).data.memberIds;
    }
    match /households/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'inviteCode', 'createdAt'])
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 24
        && request.resource.data.createdAt is int;
      // A non-member can redeem an invite without being allowed to read it.
      // Preserve the original member, code and creation metadata; add only yourself.
      allow update: if signedIn()
        && request.resource.data.joinProofs[request.auth.uid] == resource.data.inviteCode
        && request.resource.data.joinProofs.diff(resource.data.get('joinProofs', {})).affectedKeys().hasOnly([request.auth.uid])
        && ((request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinProofs']))
        || (!(request.auth.uid in resource.data.memberIds)
          && resource.data.memberIds.size() == 1
          && request.resource.data.memberIds.size() == 2
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'joinProofs'])));
      allow delete: if false;
      function validAuthor() {
        return request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
      function control() {
        return get(/databases/$(database)/documents/households/$(id)/state/current).data;
      }
      function recordWrite() {
        return isMember(id)
          && ((control().protocol == 3 && control().phase == 'migrating')
            || (control().protocol == 4
              && (control().phase == 'migrating'
                || (control().phase == 'ready'
                  && getAfter(/databases/$(database)/documents/households/$(id)/state/current).data.revision
                    == control().revision + 1))));
      }
      match /state/{stateId} {
        allow read: if stateId == 'current' && isMember(id);
        // Once a migration begins, old clients cannot downgrade or overwrite its state.
        allow create: if stateId == 'current' && isMember(id) && validAuthor()
          && request.resource.data.keys().hasOnly(['protocol', 'phase', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.protocol == 3 && request.resource.data.phase == 'migrating'
          && request.resource.data.revision == 0;
        allow update: if stateId == 'current' && isMember(id) && validAuthor()
          && ((resource.data.get('protocol', 1) != 3 && request.resource.data.protocol == 3
              && request.resource.data.phase == 'migrating' && request.resource.data.revision == 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['protocol', 'phase', 'revision', 'updatedBy', 'updatedAt']))
            || (resource.data.protocol == 3 && request.resource.data.protocol == 3 && resource.data.phase == 'migrating'
              && request.resource.data.phase == 'ready' && request.resource.data.revision == 0
              && request.resource.data.keys().hasOnly(['protocol', 'phase', 'revision', 'updatedBy', 'updatedAt']))
            || (resource.data.protocol == 3 && request.resource.data.protocol == 3 && resource.data.phase == 'ready'
              && request.resource.data.phase == 'ready' && request.resource.data.revision == resource.data.revision + 1
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision', 'updatedBy', 'updatedAt']))
            || (resource.data.protocol == 3 && resource.data.phase == 'ready'
              && request.resource.data.protocol == 4 && request.resource.data.phase == 'migrating'
              && request.resource.data.revision == resource.data.revision
              && request.resource.data.historyFloor == resource.data.revision
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['protocol', 'phase', 'historyFloor', 'updatedBy', 'updatedAt']))
            || (resource.data.protocol == 4 && resource.data.phase == 'migrating'
              && request.resource.data.protocol == 4 && request.resource.data.phase == 'ready'
              && request.resource.data.revision == resource.data.revision
              && request.resource.data.historyFloor == resource.data.historyFloor
              && request.resource.data.keys().hasOnly(['protocol', 'phase', 'revision', 'historyFloor', 'updatedBy', 'updatedAt']))
            || (resource.data.protocol == 4 && resource.data.phase == 'ready'
              && request.resource.data.protocol == 4 && request.resource.data.phase == 'ready'
              && request.resource.data.revision == resource.data.revision + 1
              && request.resource.data.historyFloor >= resource.data.historyFloor
              && request.resource.data.historyFloor <= resource.data.revision
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision', 'historyFloor', 'updatedBy', 'updatedAt'])));
        allow delete: if false;
      }
      match /shoppingRecords/{record} {
        allow read: if isMember(id);
        allow create, update: if recordWrite()
          && ((control().protocol == 4 && control().phase == 'migrating'
              && request.resource.data.revision == control().revision
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision']))
            || (validAuthor()
              && ((control().protocol == 3
                && request.resource.data.keys().hasOnly(['key', 'token', 'data', 'deleted', 'updatedBy', 'updatedAt']))
              || (control().protocol == 4 && control().phase == 'ready'
                && request.resource.data.keys().hasOnly(['key', 'token', 'data', 'deleted', 'revision', 'updatedBy', 'updatedAt'])
                && request.resource.data.revision is int
                && request.resource.data.revision == control().revision + 1))))
          && request.resource.data.key is string && request.resource.data.token is string
          && request.resource.data.deleted is bool
          && ((request.resource.data.deleted && request.resource.data.data == null)
            || (!request.resource.data.deleted && request.resource.data.data is string && request.resource.data.data.size() < 100000));
        allow delete: if recordWrite() && control().protocol == 4 && control().phase == 'ready'
          && resource.data.deleted
          && getAfter(/databases/$(database)/documents/households/$(id)/state/current).data.historyFloor >= resource.data.revision
          && resource.data.updatedAt < request.time - duration.value(30, 'd');
      }
      match /shoppingDevices/{device} {
        allow read: if isMember(id);
        allow create, update: if recordWrite() && validAuthor()
          && request.resource.data.keys().hasOnly(['batch', 'updatedBy', 'updatedAt'])
          && request.resource.data.batch is string;
        allow delete: if false;
      }
    }
  }
}
