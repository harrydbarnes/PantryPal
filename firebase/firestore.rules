rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(id) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(id)).data.memberIds;
    }
    match /households/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'inviteCode', 'createdAt'])
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 24
        && request.resource.data.createdAt is int;
      // A non-member can redeem an invite without being allowed to read it.
      // Preserve the original member, code and creation metadata; add only yourself.
      allow update: if signedIn()
        && request.resource.data.joinProofs[request.auth.uid] == resource.data.inviteCode
        && request.resource.data.joinProofs.diff(resource.data.get('joinProofs', {})).affectedKeys().hasOnly([request.auth.uid])
        && ((request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinProofs']))
        || (!(request.auth.uid in resource.data.memberIds)
          && resource.data.memberIds.size() == 1
          && request.resource.data.memberIds.size() == 2
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'joinProofs'])));
      allow delete: if false;
      match /state/{stateId} {
        allow read: if stateId == 'current' && isMember(id);
        // Reject legacy whole-backup publishers, including installed v1 clients.
        allow create, update: if stateId == 'current' && isMember(id)
          && request.resource.data.keys().hasOnly(['shoppingV2', 'protocol', 'updatedBy', 'updatedAt'])
          && request.resource.data.protocol == 2
          && request.resource.data.shoppingV2 is string
          && request.resource.data.shoppingV2.size() < 850000
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
